# Firebase (client — display real-time reads)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server — queue writes)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_PROVIDER=authjs
AUTH_URL=http://localhost:3000

# Resend (email verification, magic link, password reset)
RESEND_API_KEY=
EMAIL_FROM=LiveQue <onboarding@liveque.com>

# Upstash Redis (rate limiting — optional in dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Legacy tenant (Milwaukee Harley-Davidson)
LEGACY_TENANT_SLUG=mkehd
USE_LEGACY_QUEUE=false
SKIP_QUEUE_AUTH=true

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPER_ADMIN_EMAIL=
