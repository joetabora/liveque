rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Legacy flat queue — allow client writes until production runs the develop
    // build (server-side Admin SDK writes). Set allow write: if false after cutover.
    match /queue/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Tenant-scoped queue — public read for display boards, no client writes
    match /tenants/{tenantId}/queue/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Deny all other paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
