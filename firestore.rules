rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Legacy flat queue — read-only during migration rollback window
    match /queue/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Tenant-scoped queue — public read for display boards, no client writes
    match /tenants/{tenantId}/queue/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Deny all other paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
